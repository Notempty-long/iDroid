# Android platform requirements merged on top of Hoolock's config_16k.
# 16 KiB pages are mandatory on this target; do not silently fall back to 4 KiB.
CONFIG_ARM64_16K_PAGES=y
# CONFIG_ARM64_4K_PAGES is not set

# --- binder / Android IPC ---------------------------------------------------
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# --- memory / graphics buffer plumbing --------------------------------------
CONFIG_MEMFD_CREATE=y
CONFIG_CMA=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_SYNC_FILE=y

# --- cgroups / PSI (Android init and lmkd rely on these) ---------------------
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_BPF=y
CONFIG_MEMCG=y
CONFIG_CPUSETS=y
CONFIG_PSI=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y

# --- security ---------------------------------------------------------------
CONFIG_SECURITY=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_SELINUX_AVC_STATS=y
CONFIG_KEYS=y

# --- filesystems used by Android -------------------------------------------
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_EROFS_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_QUOTA=y

# --- netboot: NFS fallback + NBD primary ------------------------------------
CONFIG_NFS_FS=y
CONFIG_NFS_V4=y
CONFIG_ROOT_NFS=y
CONFIG_BLK_DEV_NBD=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y

# --- USB gadget: ECM (ethernet) + adb (functionfs) --------------------------
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_F_ECM=y
CONFIG_USB_F_FS=y

# --- input: evdev + uinput for hx-touchd ------------------------------------
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=y

# --- misc -------------------------------------------------------------------
CONFIG_DEBUG_FS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_BINFMT_ELF=y
