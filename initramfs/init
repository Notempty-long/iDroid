#!/bin/busybox sh
# iDroid first-stage init.
#
# Built on Hoolock's example initramfs: its init_functions.sh already knows how
# to bring up the USB gadget (NCM with RNDIS fallback) and to run a DHCP server
# so the host gets a static lease. We replace its default "debug shell"
# behaviour with an NBD bootstrap and a handoff to a Linux rootfs.
#
# Options (append to config/cmdline):
#   idroid_debug=1          stay in the first-stage shell
#   idroid_payload=android  boot the Android GSI instead of the Linux rootfs
#
# The link addresses live in config/netboot.conf and are baked into the image
# as /etc/idroid-net.conf by scripts/build-android-initramfs.sh.

set -a
LOG_PREFIX="[idroid]"

[ -e /etc/idroid-net.conf ] && . /etc/idroid-net.conf
[ -e /etc/unudhcpd.conf ] && . /etc/unudhcpd.conf
. ./init_functions.sh

# Hoolock's helpers hard-code 172.16.42.0/24. Keep their variable names but
# take the values from our single netboot config.
if [ -n "${NB_PHONE_IP:-}" ]; then
	HOST_IP="$NB_PHONE_IP"
	unudhcpd_client_ip="$NB_HOST_IP"
fi

export PATH=/usr/bin:/bin:/usr/sbin:/sbin
/bin/busybox --install -s

# Hoolock's build packs most binaries in a second cpio archive.
if [ -e /extract.cpio.lzma ]; then
  cat /extract.cpio.lzma | lzma -dc | cpio -id
  rm -f /extract.cpio.lzma
  /bin/busybox-extras --install -s
fi

mount_proc_sys_dev
setup_log

echo "iDroid first stage starting"
# Bind the network function on its own first: creating NCM and ACM before the
# first UDC bind makes the host's cdc_ncm TX path stall (NETDEV WATCHDOG,
# ARP never resolves) even though DHCP completes.
setup_usb_network
start_unudhcpd
setup_mdev

# The ACM serial carries console=ttyGS0, the only log channel before the
# display is up. Add it only after the network is up, then rebind the UDC; the
# host re-enumerates once and gets a fresh lease.
if [ -n "$(cat "$CONFIGFS/g1/UDC" 2>/dev/null)" ]; then
  setup_usb_acm_configfs
  setup_usb_configfs_udc
fi

# Stage-1 shell over the network. Keep it available even when the payload
# boots, so a failed handoff can still be inspected from the host.
if command -v telnetd >/dev/null 2>&1; then
  telnetd -b "${NB_PHONE_IP:-$HOST_IP}:23" -l /bin/sh 2>/dev/null || true
fi

if grep -q 'idroid_debug=1' /proc/cmdline 2>/dev/null; then
  echo "idroid_debug=1: staying in the first-stage shell"
  debug_shell
  while true; do sleep 255; done
fi

if grep -q 'idroid_payload=android' /proc/cmdline 2>/dev/null; then
  echo "booting Android GSI over NBD"
  exec /android.sh
fi

echo "booting Linux rootfs over NBD"
exec /linux.sh
